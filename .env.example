# Copy-free setup: run ./scripts/gen-env.sh to create .env with strong random values.
# This file only documents the variables. Never commit a real .env.
# Every variable is explained in docs/configuration.md.

# Postgres: one login role per service
POSTGRES_PASSWORD=
QA_OWNER_PASSWORD=
QA_QUEUE_PASSWORD=
QA_WEB_PASSWORD=
QA_WORKER_PASSWORD=
QA_GATEWAY_PASSWORD=

# Encryption keys: 32 random bytes, base64. Back them up securely; losing them = losing data.
GATEWAY_KEK=          # wraps WhatsApp session keys; given ONLY to the gateway
GATEWAY_KEK_ID=gw-local-v1
APP_KEK=              # wraps per-student content keys (web, worker, gateway)
APP_KEK_ID=app-local-v1

# Service-to-service authentication (64 hex chars each)
GATEWAY_SECRET_WEB=
GATEWAY_SECRET_WORKER=
SANDBOX_TOKEN=

# App
APP_BASE_URL=http://localhost:3000
FREE_SIGNUP_CREDITS=5

# OpenAI
OPENAI_API_KEY=
OPENAI_DETECT_MODEL=gpt-6-luna
OPENAI_SOLVE_MODEL=gpt-6.1-sol
OPENAI_SOLVE_EFFORT=high

# Payments (Safepay: JazzCash, Easypaisa, Raast, cards)
#   safepay   real payments; needs the three Safepay values below
#   mock      simulated checkout for local testing; refused unless APP_BASE_URL is
#             localhost AND the database allows it (only db/init/00-roles.sh does)
#   disabled  no checkout (default)
PAYMENTS_PROVIDER=disabled
SAFEPAY_ENV=sandbox          # sandbox | production
SAFEPAY_API_KEY=             # Safepay dashboard → Developers → API keys (public key, starts with sec_)
SAFEPAY_SECRET_KEY=          # same page (secret key); server-side only
SAFEPAY_WEBHOOK_SECRET=      # Safepay dashboard → Developers → Endpoints (needs a public HTTPS URL)

# Public site details (footer and legal pages)
LEGAL_NAME=QuickAssign       # the person or company that operates the service
CONTACT_EMAIL=               # support/privacy contact shown on the legal pages
CONTACT_ADDRESS=             # business address (payment providers usually require one)
REPO_URL=                    # https:// link to the public source code

# Database pool sizes (default 10) aren't passed through from this file. Set DB_POOL_MAX and
# QUEUE_POOL_MAX in a docker-compose.override.yml instead.
